---
import {getEntry} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {Hero, Definition as DefinitionSection, PurposeSection, ProductSection, OnboardingSection} from '../../components/home';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'id' } },
  ];
}
const { lang } = Astro.params;

// Fetch entry
const entry = await getEntry('translations', lang);
const hero = entry?.data?.home?.hero;
const definitionSection = entry?.data?.home?.definitionSection;
const purposeSection = entry?.data?.home?.purposeSection;
const productSection = entry?.data?.home?.productSection;
const onboardingSection = entry?.data?.home?.onboardingSection;

---
<Layout>
    <title slot="head">Derivio Home</title>
    <meta slot="head" name="title" content="Derivio"/>
    <meta slot="head" name="description" content="Derivio is a decentralized derivatives marketplace that allows users to trade and hedge derivatives with low fees and high liquidity."/>
    <main>
        <Hero heroData={hero} imageUrl={"/hero.jpg"} client:visible />
        <DefinitionSection definitionData={definitionSection} client:visible />
        <PurposeSection purposeData={purposeSection} client:visible />
        <ProductSection productData={productSection} lang={lang} client:visible />
        <OnboardingSection onboardingData={onboardingSection} client:visible />
    </main>
</Layout>