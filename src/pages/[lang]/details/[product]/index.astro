---
import Layout from '../../../../layouts/Layout.astro';
import {HeroDetailsSection, HowItWorksSection} from '../../../../components/details';
import {getEntry} from 'astro:content';

const {product} = Astro.params;

export async function getStaticPaths() {
  return [
    { params: { product: 'futures', lang: 'en' } },
    { params: { product: 'futures', lang: 'id' } },
    { params: { product: 'forwards', lang: 'en' } },
    { params: { product: 'forwards', lang: 'id' } },
    { params: { product: 'options', lang: 'en' } },
    { params: { product: 'options', lang: 'id' } },
    { params: { product: 'swaps', lang: 'en' } },
    { params: { product: 'swaps', lang: 'id' } },
  ];
}

const entry = await getEntry('translations', Astro.params.lang);
const derivativeProduct = entry?.data?.details?.[product as keyof typeof entry.data.details];
const howItWorksData = derivativeProduct?.howItWorks;
---
<Layout>
    <title slot="head">Details {product} | Derivio</title>
    <meta slot="head" name="title" content={`Details ${product}`}/>
    <meta slot="head" name="description" content={`Details ${product}`}/>
    <main>
        <HeroDetailsSection heroData={derivativeProduct?.overview} imageUrl={`/${product}-illustration1.jpg`} client:visible />
        <HowItWorksSection howItWorksData={howItWorksData} product={product} client:visible />
    </main>
</Layout>