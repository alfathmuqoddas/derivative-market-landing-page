---
const content = [
  {
    title: "Quick Links",
    links: [
      {
        title: "Home",
        href: "/",
      },
      {
        title: "About",
        href: "/about",
      },
      {
        title: "Contact",
        href: "/contact",
      },
    ],
  },
  {
    title: "Legal",
    links: [
      {
        title: "Terms of Service",
        href: "/terms",
      },
      {
        title: "Privacy Policy",
        href: "/privacy",
      },
    ],
  }
]
---
<footer class="container mx-auto px-4 border-t border-gray-200 py-16">
  <div class="flex flex-col md:flex-row items-start justify-between gap-4">
    <div>
      <h1 class="font-bold font-serif text-xl text-blue-800">DERIVIO</h1>
      <p class="text-gray-700 text-sm">
        ©{new Date().getFullYear()} Derivative Market Landing Page
      </p>
    </div>
    {
      content.map((item: any) => {
        return (
          <div class="flex flex-col gap-2">
            <h2 class="font-bold text-xl text-blue-800">{item.title}</h2>
            <ul class="flex flex-col gap-2">
              {item.links.map((link: any) => {
                return (
                  <li class="hover:text-blue-900">
                    <a href={link.href}>{link.title}</a>
                  </li>
                )
              })}
            </ul>
          </div>
        )
      })
    }
  </div>
</footer>